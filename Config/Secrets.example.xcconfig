// Copy to Config/Secrets.xcconfig (gitignored) and fill in the keys you need.
// Leave a key empty to keep its feature off: a placeholder value would turn
// the feature on with a key that doesn't work.
// NEVER put the Supabase service_role key here or anywhere in the app.
//
// xcconfig treats "//" as a comment, so URLs must split the slashes with $():
//   SUPABASE_URL = https:/$()/your-project-ref.supabase.co

// Sync and groups. Google sign-in needs these and the three Google IDs.
//   SUPABASE_URL = https:/$()/your-project-ref.supabase.co
//   SUPABASE_ANON_KEY = your-anon-key
SUPABASE_URL =
SUPABASE_ANON_KEY =

// Google sign-in, for example:
//   GOOGLE_IOS_CLIENT_ID = 1234567890-abc.apps.googleusercontent.com
//   GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abc
//   GOOGLE_SERVER_CLIENT_ID = 1234567890-xyz.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID =
GOOGLE_SERVER_CLIENT_ID =

// Ask AI (S39): an OpenRouter key created with a $0 credit limit, so it can
// only call free models (for example sk-or-v1-...). Leave it empty to hide the
// Ask AI button. The model ID is a free one from
// https:/$()/openrouter.ai/api/v1/models (the free list rotates;
// openrouter/free picks any free model).
OPENROUTER_API_KEY =
OPENROUTER_MODEL = cohere/north-mini-code:free

// Your Apple developer team ID, to install on a phone (Xcode > Settings >
// Accounts, or the OU of your "Apple Development" certificate).
DEVELOPMENT_TEAM =
